# Copiar a .env y ajustar. Nunca commitear el .env real (ver .gitignore).

SPRING_PROFILES_ACTIVE=dev

MYSQL_ROOT_PASSWORD=root
DB_NAME=montanari_contable
DB_USERNAME=montanari
DB_PASSWORD=montanari

# F11.1 B6: este valor es un PLACEHOLDER inerte — nunca es el secreto real de
# ningún .env en uso (antes de este fix, este archivo tenía el mismo valor
# que el .env real, comprometiendo la firma de todos los tokens). Generar el
# propio con `py -c "import secrets; print(secrets.token_urlsafe(48))"` (o
# equivalente) al copiar a .env — nunca reusar el string de abajo.
JWT_SECRET=5CRUpwf1m5-eW3ncgNuZ66ul80h3zuLyB3pAI4XYVjQlZh7u8rlRqi8W9rx3KT2O
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Origen(es) del frontend permitidos por CORS (separados por coma si hay más
# de uno). En dev por defecto es http://localhost:5173 si no se define acá.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# F11.3: solo aplica con SPRING_PROFILES_ACTIVE=prod (ver logback-spring.xml).
# Días de retención de los logs rotados en backend_logs. No confundir con
# auditoría de negocio (AuditoriaLog, en la base) — esto es log operativo.
LOG_RETENTION_DAYS=30

# F11.3: solo relevantes para docker-compose.prod.yml (ver ops/backup/).
BACKUP_DIR=/var/backups/montanari-contable
DAILY_RETENTION_DAYS=14
MONTHLY_RETENTION_MONTHS=12
# Ruta local secundaria opcional para el backup (ver ops/backup/offsite_hook.sh).
# Sin destino remoto real configurado todavía — ver docs/RUNBOOK.md.
SECONDARY_BACKUP_DIR=
